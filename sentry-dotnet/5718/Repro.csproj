<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Override the version with -p:SentryVersion=..., or test a local checkout with -p:SentryAspNetCoreProject=/path/to/src/Sentry.AspNetCore/Sentry.AspNetCore.csproj -->
    <SentryVersion Condition="'$(SentryVersion)' == ''">7.0.0</SentryVersion>
  </PropertyGroup>

  <ItemGroup Condition="'$(SentryAspNetCoreProject)' == ''">
    <PackageReference Include="Sentry.AspNetCore" Version="$(SentryVersion)" />
  </ItemGroup>
  <ItemGroup Condition="'$(SentryAspNetCoreProject)' != ''">
    <ProjectReference Include="$(SentryAspNetCoreProject)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.TestHost" Version="8.0.11" />
  </ItemGroup>

</Project>
